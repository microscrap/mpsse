{
    "name": "microscrap/mpsse",
    "description": "MPSSE SPI/I2C/GPIO helpers extending the FTDI package",
    "type": "library",
    "version": "0.8.0",
    "keywords": [
        "framework",
        "scrapyard-io",
        "mpsse",
        "ftdi",
        "bindings"
    ],
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/mpsse/0.7.x/overview",
    "support": {
        "docs": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/mpsse/0.7.x/overview",
        "source": "https://github.com/microscrap/mpsse",
        "issues": "https://github.com/microscrap/mpsse/issues"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-ftdi": "^0.8.0",
        "microscrap/ftdi": "^0.8.0"
    },
    "suggest": {
        "scrapyard-io/gpio-framework": "^0.7 — higher-level FTDI UART / USB / MPSSE adapters"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\MPSSE\\": "src/"
        },
        "files": [
            "src/Helpers/mpsse.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
